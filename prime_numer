# most recommended method for interviews
num=9
if num>1:
    for i in range(2,int(num**0.5)+1):
        if num%i==0:
            print(" not prime")
            break
    else:
         print(" prime")
else:
    print("not prime number")


# print 1 to n prime numbers
n=30
for num in range(2,n+1):
    prime=True
    for i in range(2,num):
        if num%i==0:
            prime=False
            break
    if prime:
       print(num,end=" ")


#using while loop 
n=8
i=2
count=0
while i<n:
    if n%i==0:
        count+=1
    i+=1
if count==0:
    print("not prime")
else:
    print("prime")
